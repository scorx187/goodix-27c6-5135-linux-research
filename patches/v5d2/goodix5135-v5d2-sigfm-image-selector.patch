+static gboolean
+fp_print_sigfm_info_equal (SigfmImgInfo *a,
+                           SigfmImgInfo *b)
+{
+  g_autofree guchar *a_data = NULL;
+  g_autofree guchar *b_data = NULL;
+  gint a_len = 0;
+  gint b_len = 0;
+
+  if (a == NULL || b == NULL)
+    return FALSE;
+
+  a_data =
+    sigfm_serialize_binary (
+      a,
+      &a_len);
+
+  b_data =
+    sigfm_serialize_binary (
+      b,
+      &b_len);
+
+  if (a_data == NULL ||
+      b_data == NULL ||
+      a_len <= 0 ||
+      b_len <= 0 ||
+      a_len != b_len)
+    return FALSE;
+
+  return memcmp (
+           a_data,
+           b_data,
+           (gsize) a_len) == 0;
+}
